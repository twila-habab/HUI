# From https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token
CLIENT_ID=your-application-id
# Optional: register commands to specific servers (comma-separated) so they update instantly
GUILD_ID=

# Each server has a receipts channel and a general channel. Receipts go to the
# receipts channel and /repost picks from there. Every day at 00:00 UTC a random
# receipt is posted into the anon general channel (the others are unused for now).
# (right-click a channel in Discord → Copy Channel ID; needs Developer Mode on)
DISCORD_RECEIPTS_ID=
ANON_GENERAL=
FUNNIES_ID=
HANGOUT_GENERAL=
RECEIPTS_OF_SHAME_ID=
GFORCE_GENERAL=
# Optional: also repost automatically every N minutes into the general channels
# (only once they're wired back up in src/config.ts)
REPOST_INTERVAL_MINUTES=

# Optional: where the message index is saved (default: data). Point this at a
# persistent volume when hosting, e.g. /data
DATA_DIR=
